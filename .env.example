PORT=3000
SITE_URL=https://joseph.clonecentre.ai

# CloneCentre OS — publish the operator product at https://os.clonecentre.ai.
# Keep this key long and private until organisation accounts replace pilot access.
OS_ACCESS_KEY=replace_with_a_long_random_access_key
OS_WORKSPACE_KEY=clone-centre
OS_PUBLIC_URL=https://os.clonecentre.ai
# 32+ random characters used only to encrypt provider access and refresh tokens.
OS_TOKEN_ENCRYPTION_KEY=replace_with_a_long_independent_random_key
# Optional live pipeline directory. Production falls back to the bundled snapshot.
OS_CONTENT_DIR=/absolute/path/to/social_output

# Channel apps. Customer OAuth is enabled only after the corresponding provider
# has reviewed the app and the exact https://os.clonecentre.ai callback URLs.
META_APP_ID=
META_APP_SECRET=
TIKTOK_MARKETING_APP_ID=
TIKTOK_MARKETING_SECRET=
# Optional separate Login Kit credentials for organic-account features.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional overrides. Defaults request the read/reporting scopes shown in OS.
META_OAUTH_SCOPES=
TIKTOK_OAUTH_SCOPES=
GOOGLE_OAUTH_SCOPES=

# Server-side intelligence and rendering providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
RUNWAY_API_KEY=
STABILITY_API_KEY=

# Railway reference variable in production: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://clonecentre:replace_me@localhost:5432/clonecentre

STRIPE_WEBHOOK_SECRET=whsec_replace_me
RESEND_API_KEY=re_replace_me
DELIVERY_FROM_EMAIL=Clone Centre <books@updates.clonecentre.ai>
DELIVERY_REPLY_TO=joseph@clonecentre.ai
NEWSLETTER_FROM_EMAIL=Joseph at Clone Centre <hello@updates.clonecentre.ai>
RESEND_NEWSLETTER_SEGMENT_ID=replace_with_resend_segment_id
CHAT_TRANSCRIPTS_EMAIL=joseph@clonecentre.ai
CHAT_TRANSCRIPTS_FROM_EMAIL=Clone Centre AI <hello@updates.clonecentre.ai>
MEMBER_NOTIFICATIONS_EMAIL=joseph@clonecentre.ai
MEMBER_FROM_EMAIL=Joseph at Clone Centre <hello@updates.clonecentre.ai>

HYPERCHAT_BASE_URL=https://hyperchat-app-production.up.railway.app
HYPERCHAT_PROJECT_ID=96991323-4ffc-47a7-99bd-905af714a0d5

CAL_PROFILE_URL=https://cal.com/replace_with_username
CAL_AI_FIX_URL=https://cal.com/replace_with_username/ai-fix-session
CAL_AI_POWER_URL=https://cal.com/replace_with_username/ai-power-session
CAL_BUILD_PARTNER_URL=https://cal.com/replace_with_username/ai-build-partner
CAL_WEBHOOK_SECRET=replace_with_random_secret
BOOKING_FROM_EMAIL=Joseph at Clone Centre <hello@updates.clonecentre.ai>

# Local integration tests only. This is deliberately ignored in production.
DELIVERY_DRY_RUN=false
